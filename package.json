{
  "name": "lenaruppert.de",
  "description": "Lenaruppert website",
  "version": "1.0.64",
  "author": "Florian Hirsch",
  "license": "UNLICENSED",
  "private": true,
  "main": "n/a",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=18.0.0 <26"
  },
  "scripts": {
    "clean": "rimraf .cache public",
    "develop": "gatsby develop",
    "build": "pnpm run clean && gatsby build",
    "serve": "gatsby serve",
    "format": "pnpm exec prettier --trailing-comma es5 --no-semi --single-quote --write 'src/**/*.{js,jsx,ts,tsx}'",
    "type-check": "tsc --noEmit",
    "lint": "pnpm exec eslint .",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx}": [
      "pnpm run lint",
      "pnpm run format"
    ]
  },
  "dependencies": {
    "@emotion/core": "^11.0.0",
    "@emotion/react": "^11.1.2",
    "@emotion/styled": "^11.0.0",
    "bulma": "^0.9.0",
    "emotion": "^11.0.0",
    "emotion-server": "^11.0.0",
    "gatsby": "^5.16.1",
    "gatsby-plugin-emotion": "^8.16.0",
    "gatsby-plugin-netlify": "^5.1.1",
    "gatsby-plugin-sharp": "^5.16.0",
    "gatsby-plugin-sitemap": "^6.16.0",
    "gatsby-plugin-typography": "^5.16.0",
    "gatsby-remark-external-links": "^0.0.4",
    "gatsby-remark-images": "^7.16.0",
    "gatsby-source-filesystem": "^5.16.0",
    "gatsby-transformer-remark": "^6.16.0",
    "gatsby-transformer-sharp": "^5.16.0",
    "react": "^19.2.8",
    "react-cookie-consent": "^10.0.2",
    "react-dom": "^19.2.8",
    "react-typography": "^0.16.19",
    "typography": "^0.16.19",
    "typography-theme-de-young": "^0.16.19"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "eslint": "^9.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.20.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3"
  }
}
