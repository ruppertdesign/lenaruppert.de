{
  "name": "lenaruppert.de",
  "description": "Lenaruppert website",
  "version": "1.0.55",
  "author": "Florian Hirsch",
  "license": "UNLICENSED",
  "private": true,
  "main": "n/a",
  "engines": {
    "node": ">=18.0.0 <26"
  },
  "scripts": {
    "clean": "rimraf .cache public",
    "develop": "gatsby develop",
    "build": "yarn clean && gatsby build",
    "serve": "gatsby serve",
    "format": "yarn prettier --trailing-comma es5 --no-semi --single-quote --write 'src/**/*.{js,jsx,ts,tsx}'",
    "graphql-types": "gql-gen",
    "type-check": "tsc --noEmit",
    "lint": "yarn eslint . --ext .js,.jsx,.ts,.tsx"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged && yarn version --patch --no-git-tag-version && git add package.json"
    }
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx}": [
      "yarn run lint",
      "yarn run format"
    ]
  },
  "dependencies": {
    "@emotion/core": "^11.0.0",
    "@emotion/react": "^11.1.2",
    "@emotion/styled": "^11.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/react-helmet": "^6.0.0",
    "bulma": "^0.9.0",
    "emotion": "^11.0.0",
    "emotion-server": "^11.0.0",
    "eslint-utils": "^2.0.0",
    "gatsby": "^5.16.1",
    "gatsby-plugin-emotion": "^8.16.0",
    "gatsby-plugin-netlify": "^5.1.1",
    "gatsby-plugin-react-helmet": "^6.16.0",
    "gatsby-plugin-sharp": "^5.16.0",
    "gatsby-plugin-sitemap": "^6.16.0",
    "gatsby-plugin-typography": "^5.16.0",
    "gatsby-remark-external-links": "^0.0.4",
    "gatsby-remark-images": "^7.16.0",
    "gatsby-source-filesystem": "^5.16.0",
    "gatsby-transformer-remark": "^6.16.0",
    "gatsby-transformer-sharp": "^5.16.0",
    "react": "^18.3.0",
    "react-cookie-consent": "^6.2.1",
    "react-dom": "^18.3.0",
    "react-helmet": "^6.0.0",
    "react-markdown": "^5.0.3",
    "react-typography": "^0.16.19",
    "typescript": "^5.4.0",
    "typography": "^0.16.19",
    "typography-theme-de-young": "^0.16.19"
  },
  "resolutions": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^4.1.0",
    "@typescript-eslint/parser": "^4.1.0",
    "eslint": "^7.2.0",
    "eslint-config-prettier": "^7.0.0",
    "eslint-plugin-react": "^7.20.0",
    "graphql-code-generator": "^0.18.2",
    "graphql-codegen-typescript-client": "^0.18.2",
    "graphql-codegen-typescript-common": "^0.18.2",
    "graphql-codegen-typescript-server": "^0.18.2",
    "husky": "^4.2.3",
    "lint-staged": "^10.0.8",
    "prettier": "^2.0.5",
    "rimraf": "^3.0.0"
  }
}
